# Local development environment. Copy to .env and fill in real values.
# .env is git-ignored; this example file must never contain real secrets.

SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
ALLOWED_HOSTS=*

# Local Postgres (or point at a shared dev database).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/drrasheljo

CORS_ALLOWED_ORIGINS=http://localhost:5173
REDIS_URL=redis://localhost:6379/0

# Outbound email: leave EMAIL_HOST empty in dev to use the console backend
# (emails print to the runserver terminal). Set these to test real delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Dr Rashel Jo <no-reply@dr-rasheljo.com>
