# Production environment variables — every value here must be set for real,
# not left at a placeholder. config/settings_production.py fails to import
# if any required one is missing (verified in this session).

# Use the hardened production settings overlay (security headers, no console
# email fallback, no SQLite fallback). Without this the app runs on
# config/settings.py — which still works, but you must then set the EMAIL_*
# vars below explicitly or password-reset / order emails go to stdout only.
DJANGO_SETTINGS_MODULE=config.settings_production

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-service.onrender.com,dr-rasheljo.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
CORS_ALLOWED_ORIGINS=https://dr-rasheljo.com
CSRF_TRUSTED_ORIGINS=https://dr-rasheljo.com
REDIS_URL=redis://HOST:6379/0
# Django's page/data cache uses REDIS_URL's next logical DB (…/1) automatically.
# Set this only to put the cache on a different Redis instance.
# CACHE_REDIS_URL=redis://HOST:6379/1

# Public origin used to build absolute links in emails (password reset) and
# sitemap.xml / robots.txt. No trailing slash. Set to the real deployed URL.
SITE_URL=https://dr-rasheljo.com

# --- Outbound email (required for password reset to be delivered) ---
# Any SMTP provider works (Resend, SendGrid, Mailgun, Amazon SES, Postmark…).
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
# From address MUST be a verified sender / domain with the provider above, or
# the provider will reject or silently drop the message.
DEFAULT_FROM_EMAIL=Dr Rashel Jo <no-reply@dr-rasheljo.com>

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Optional: card payment gateway (see payments/services.py — until these are
# set, card payments correctly fail rather than faking success)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Optional: S3-backed media storage instead of local disk
MEDIA_STORAGE_BACKEND=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
